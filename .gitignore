# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
.venv/
__pycache__/
*.py[cod]

# Local backups and archives
backups/
*.zip

# Versioned Python backend sources; keep runtime state and the nested frontend
# outside this Next.js repository.
innergeodessa-mvp/*
!innergeodessa-mvp/backend/
!innergeodessa-mvp/tests/

innergeodessa-mvp/backend/*
!innergeodessa-mvp/backend/app/
!innergeodessa-mvp/backend/data/
!innergeodessa-mvp/backend/schema.sql
!innergeodessa-mvp/backend/requirements.txt
!innergeodessa-mvp/backend/requirements-dev.txt

innergeodessa-mvp/backend/app/*
!innergeodessa-mvp/backend/app/*.py

innergeodessa-mvp/backend/data/*
!innergeodessa-mvp/backend/data/items.json

innergeodessa-mvp/tests/*
!innergeodessa-mvp/tests/*.py
